# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
AGENT_MAX_STEPS=8

# Standard instrument catalog:
# - data/instruments.csv is treated as local/private data and is ignored by git.
# - If data/instruments.csv does not exist, the app falls back to data/instruments_demo.csv.
INSTRUMENTS_PATH=

# Embedding priority:
# - Leave LOCAL_EMBEDDING_MODEL empty for API/hash fallback.
# - After downloading BAAI/bge-m3 locally, set LOCAL_EMBEDDING_MODEL=./models/bge-m3.
# - auto uses the local model first, then OpenAI-compatible API, then hash fallback.
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

LOCAL_EMBEDDING_MODEL=

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=metrology_standards
HASH_EMBEDDING_DIMENSIONS=384


EMBEDDING_BATCH_SIZE=10
